import runpod
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration

# Global variables to cache model elements on startup
tokenizer = None
model = None

def load_model():
    global tokenizer, model
    if model is None:
        print("Loading DIPPER model into VRAM...")
        # DIPPER requires google/t5-v1_1-xxl tokenizer config baseline
        tokenizer = T5Tokenizer.from_pretrained('google/t5-v1_1-xxl')
        model = T5ForConditionalGeneration.from_pretrained('kalpeshk2011/dipper-paraphraser-xxl')
        
        if torch.cuda.is_available():
            model = model.cuda()
        model.eval()
        print("Model loaded successfully.")

def handler(job):
    """
    Expects JSON input structure:
    {
        "input": {
            "text": "Your text here",
            "lex": 20, 
            "order": 20,
            "max_tokens": 512
        }
    }
    """
    job_input = job.get("input", {})
    text = job_input.get("text")
    
    if not text:
        return {"error": "No text provided in the input payload."}
        
    # Default parameters based on the official DIPPER configurations
    lex_diversity = job_input.get("lex", 20)
    order_diversity = job_input.get("order", 20)
    max_tokens = job_input.get("max_tokens", 512)
    
    # Format requirements for context-aware DIPPER format mapping
    prompt = f"lexical = {lex_diversity}, order = {order_diversity} <sent> {text} </sent>"
    
    # Load model context tracking if it hasn't already warmed up
    load_model()
    
    inputs = tokenizer([prompt], return_tensors="pt")
    if torch.cuda.is_available():
        inputs = {k: v.cuda() for k, v in inputs.items()}
        
    with torch.no_grad():
        final_outputs = model.generate(**inputs, max_length=max_tokens)
        
    paraphrased_text = tokenizer.decode(final_outputs[0], skip_special_tokens=True)
    
    return {"paraphrase": paraphrased_text}

# Start the automated RunPod event listener loops
if __name__ == '__main__':
    load_model() # Trigger download during cold-start boot optimization stage
    runpod.serverless.start({"handler": handler})
